// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "Rust",
	// Dedicated image: rust + node + Claude Code + rust-analyzer + the
	// rust-analyzer-lsp plugin are baked in by the Dockerfile.
	"build": {
		"dockerfile": "Dockerfile"
	},
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"remoteUser": "vscode",
	"remoteEnv": {
		"GH_TOKEN": "${localEnv:GH_TOKEN}"
	},
	// Volumes survive rebuilds: cargo cache, and Claude state. The Dockerfile
	// sets CLAUDE_CONFIG_DIR so everything, including what would otherwise be
	// ~/.claude.json, lives in /home/vscode/.claude (the "claude-config"
	// volume, named per-project below) -- EXCEPT the login token, which
	// setup-claude-auth.sh symlinks in from the separate "claude-auth" volume.
	// claude-auth has a fixed name (not scoped to this project) so it's the
	// same volume across every devcontainer on this machine: log in once,
	// and any project's devcontainer -- including a rebuilt claude-config --
	// picks it up. For another project to share it, its devcontainer.json
	// needs this same mount with source "devcontainer-claude-auth-shared".
	"mounts": [
		{
			"source": "${localWorkspaceFolderBasename}-devcontainer-cargo-cache",
			"target": "/usr/local/cargo",
			"type": "volume"
		},
		{
			"source": "${localWorkspaceFolderBasename}-devcontainer-claude-config",
			"target": "/home/vscode/.claude",
			"type": "volume"
		},
		// Bind the host git config so name/email survive rebuilds. SSH keys are
		// not mounted: VS Code forwards the host SSH agent into the container
		// automatically, so the key never leaves the host.
		{
			"source": "${localEnv:HOME}/.gitconfig",
			"target": "/home/vscode/.gitconfig",
			"type": "bind"
		}
	],

	"customizations": {
		"vscode": {
			"extensions": [
				"spencerwmiles.vscode-task-buttons"
			]
		}
	}
}
